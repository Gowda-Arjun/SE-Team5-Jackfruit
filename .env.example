# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Payments (HMS-F-021): "mock" works offline. For Razorpay test mode set "razorpay" and the test keys below.
# Must not be left empty: an empty value is not treated as "mock".
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
